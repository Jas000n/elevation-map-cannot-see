---
// Clips side by side: `cols` on wide screens, one per row on narrow ones.
interface Props {
  cols?: 2 | 3 | 4;
}

const { cols = 2 } = Astro.props;
---

<div
  class:list={[
    "my-8 grid gap-y-8",
    // four short loops stay two abreast even on a phone
    cols === 4
      ? "grid-cols-2 gap-x-3 sm:gap-x-5 xl:grid-cols-4"
      : cols === 3
        ? "grid-cols-1 gap-x-5 md:grid-cols-3"
        : "grid-cols-1 gap-x-5 sm:grid-cols-2",
  ]}
>
  <slot />
</div>
