---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  // No url: shown greyed out and not clickable, with `pending` beside the name.
  url?: string;
  name: string;
  icon?: string;
  pending?: string;
};

interface Props {
  title: string;
  subtitle?: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, subtitle, authors, conference, notes, links } = Astro.props;

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-12",
    hasBackground && "-mt-16 pt-24 pb-28",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        {/* Darken the cover so the white header text stays legible. */}
        <div class="absolute inset-0 bg-black/40" />
      </div>
    )
  }
  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-[50rem] flex-col items-center px-6 text-center",
      hasBackground
        ? "gap-10 text-white prose-headings:text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]"
        : "gap-6",
    ]}
  >
    <div class="flex flex-col items-center gap-4">
      <h1 class="my-0 text-5xl font-medium text-balance">{title}</h1>
      {subtitle && <p class="my-0 text-2xl leading-snug text-balance">{subtitle}</p>}
    </div>
    {authors.length > 0 && (
    <div class="flex flex-row flex-wrap justify-center gap-x-6 gap-y-3">
      {
        authors.map((author) => (
          <div class="flex flex-col items-center text-center">
            <div class="flex flex-row text-xl">
              {author.url ? (
                <a class:list={[hasBackground && "not-prose text-blue-200 hover:text-blue-100 underline decoration-dashed underline-offset-4 hover:decoration-solid"]} href={author.url}>{author.name}</a>
              ) : (
                author.name
              )}
              {author.notes && (
                <sup class="text-xl">
                  {author.notes.map(
                    (note, index, array) =>
                      note + (index < array.length - 1 ? "," : ""),
                  )}
                </sup>
              )}
            </div>
            {author.institution && <div>{author.institution}</div>}
          </div>
        ))
      }
    </div>
    )}
    {conference && <div>{conference}</div>}
    {
      notes && (
        <div class="flex flex-row flex-wrap justify-center gap-x-5 gap-y-1 text-center text-base">
          {
            // prettier-ignore
            notes.map((note) => (
              <span>
                <sup>{note.symbol}</sup>{note.text}
              </span>
            ))
          }
        </div>
      )
    }
    {
      links && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) =>
            link.url ? (
              <a
                href={link.url}
                class:list={["flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline",
                  hasBackground ? "bg-white hover:bg-zinc-200 text-zinc-800 text-shadow-none shadow-[0_0_8px_rgba(0,0,0,0.6)]" : "bg-zinc-800 text-white hover:bg-black dark:text-zinc-900 dark:hover:bg-zinc-50 dark:bg-zinc-200"
                ]}
              >
                {link.icon && <Icon name={link.icon} />}
                <span>{link.name}</span>
              </a>
            ) : (
              <span
                aria-disabled="true"
                class:list={["flex cursor-not-allowed flex-row items-center gap-2 rounded-full px-5 py-2 text-lg select-none",
                  hasBackground ? "bg-zinc-400/80 text-zinc-700 text-shadow-none" : "bg-zinc-300 text-zinc-500 dark:bg-zinc-700 dark:text-zinc-400"
                ]}
              >
                {link.icon && <Icon name={link.icon} />}
                <span>{link.name}</span>
                {link.pending && <span class="text-sm">({link.pending})</span>}
              </span>
            ),
          )}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
